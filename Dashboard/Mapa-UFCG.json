        "type": "function",
        "z": "249c681cecbfe853",
        "name": "LAT",
        "func": "// Lê o estado vindo da lógica (1, 2 ou 3)\nconst estadoSwitch = Number(1);\n\n\n// Estado padrão\nlet estado = \"invalido\";\n\nswitch (estadoSwitch) {\n    case 1:\n        estado = \"funcionando\";\n        break;\n\n    case 0:\n        estado = \"aguardando\";\n        break;\n\n    case -1:\n        estado = \"invalido\";\n        break;\n\n    default:\n        estado = \"invalido\";\n        break;\n}\n\n// Payload final para o Dashboard 2.0\nmsg.payload = {\n    estado: estado,\n    aplicacao: \"LAT\" \n};\n\nreturn msg;\n",

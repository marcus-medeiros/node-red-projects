        "format": "<div style=\"\n    width:100%;\n    padding:15px;\n    background:#d1d5db;\n    border-radius:12px;\n    text-align:center;\n    font-family:Arial;\n\">\n\n    <div style=\"\n        font-size:18px;\n        font-weight:bold;\n        margin-bottom:10px;\n        color:#374151;\n    \">\n        DATA / HORA\n    </div>\n\n    <div id=\"relogio\" style=\"\n        font-size:28px;\n        color:black;\n        font-weight:bold;\n    \">\n        Carregando...\n    </div>\n\n</div>\n\n<script>\nsetInterval(function() {\n\n    const now = new Date();\n\n    const data =\n        now.toLocaleDateString('pt-BR');\n\n    const hora =\n        now.toLocaleTimeString('pt-BR');\n\n    document.getElementById(\"relogio\").innerHTML =\n        data + \" - \" + hora;\n\n}, 1000);\n</script>",
